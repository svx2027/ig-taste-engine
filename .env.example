# ig-taste-engine does not require any API keys: it reads public post pages via
# yt-dlp and drives your own already-logged-in browser session for enumeration.
# This file is kept for optional future config knobs.

# Directory all scripts read/write under by default (every script also accepts
# --data-dir to override this per-invocation without touching the environment).
IG_DATA_DIR=data

# Optional pacing knob for dl_feed.py: seconds to sleep between download
# attempts, to stay well within a human-like pace. 0 = no extra sleep.
DL_PACE=0
